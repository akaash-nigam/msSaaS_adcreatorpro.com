# ==================== SERVER CONFIG ====================
NODE_ENV=production
PORT=8080
FRONTEND_URL=https://adcreatorpro.com

# ==================== DATABASE ====================
# Cloud SQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=adcreatorpro_db

# For Cloud SQL Proxy
# CLOUD_SQL_CONNECTION_NAME=project:region:instance

# ==================== FIREBASE ====================
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Frontend Firebase Config (for client-side)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ==================== OPENAI ====================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==================== STRIPE ====================
# Get these from Stripe Dashboard

# API Keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# Webhook Secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Product Price IDs (create these in Stripe Dashboard)
# For subscriptions:
STRIPE_PRICE_STARTER=price_1ABC123starter  # $9/month
STRIPE_PRICE_PRO=price_1ABC123pro          # $29/month
STRIPE_PRICE_BUSINESS=price_1ABC123business # $79/month

# For one-time ad purchases:
STRIPE_PRICE_ONE_AD=price_1ABC123onead     # $1.99 per ad
STRIPE_PRICE_FIVE_ADS=price_1ABC123fiveads # $9.95 for 5 ads

# ==================== OPTIONAL ====================
# Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry (Error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================== INSTRUCTIONS ====================
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env to version control (it's in .gitignore)
# 4. For Cloud Run deployment, set these in Cloud Run environment variables
